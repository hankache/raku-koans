is 2 R/ 3, 1.5, 'R/ divides the right side by the left';
is 2 R- 1, -1, 'R- subtracts the left side from the right';
is [+](1, 2, 3, 4, 5), 15, '[+] adds up a list';
is [*](1, 2, 3, 4, 5), 120, '[*] multiplies a list';
is [~]('a', 'b', 'c'), 'abc', 'it works with any infix operator';
is [max](3, 9, 2), 9, 'even max';
