is 3 div 2, 1, 'div is integer division; it rounds down';
is 7 % 4, 3, '% gives the remainder';
is 6 %% 4, False, '%% asks: is the left side divisible by the right?';
is 6 %% 3, True, 'six is divisible by three';
is 6 gcd 9, 3, 'gcd: the greatest common divisor';
is 6 lcm 9, 18, 'lcm: the least common multiple';
