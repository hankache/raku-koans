is 9 == 7, False, '== numeric equality';
is 9 != 7, True, '!= numeric inequality';
is 9 < 7,  False, '< less than';
is 7 <= 7, True, '<= less than or equal';
is 9 >= 7, True, '>= greater than or equal';
is 1 <=> 1.0, Same, '<=> compares three ways: 1 and 1.0 are the same number';
is 1 <=> 2, Less, 'one is less than two';
is 3 <=> 2, More, 'three is more than two';
